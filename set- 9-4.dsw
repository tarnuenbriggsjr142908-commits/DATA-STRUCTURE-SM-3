//Write a program to perform above operations using circular doubly linked list*/

#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node *prev;
    Node *next;
};

class CircularDoublyList
{
    Node *head;

public:
    CircularDoublyList()
    {
        head = NULL;
    }

    void create()
    {
        int n, value;

        cout << "Enter number of nodes: ";
        cin >> n;

        for (int i = 0; i < n; i++)
        {
            cout << "Enter value: ";
            cin >> value;

            insertLast(value);
        }
    }

    void insertFirst()
    {
        int value;

        cout << "Enter value: ";
        cin >> value;

        Node *newNode = new Node;
        newNode->data = value;

        if (head == NULL)
        {
            newNode->next = newNode;
            newNode->prev = newNode;
            head = newNode;
            return;
        }

        Node *last = head->prev;

        newNode->next = head;
        newNode->prev = last;

        last->next = newNode;
        head->prev = newNode;

        head = newNode;
    }

    void insertLast(int value)
    {
        Node *newNode = new Node;
        newNode->data = value;

        if (head == NULL)
        {
            newNode->next = newNode;
            newNode->prev = newNode;
            head = newNode;
            return;
        }

        Node *last = head->prev;

        newNode->next = head;
        newNode->prev = last;

        last->next = newNode;
        head->prev = newNode;
    }

    void insertLast()
    {
        int value;

        cout << "Enter value: ";
        cin >> value;

        insertLast(value);
    }

    void display()
    {
        if (head == NULL)
        {
            cout << "List is empty." << endl;
            return;
        }

        Node *temp = head;

        cout << "Forward: ";

        do
        {
            cout << temp->data << " ";
            temp = temp->next;
        } while (temp != head);

        cout << endl;
    }

    void displayReverse()
    {
        if (head == NULL)
            return;

        Node *last = head->prev;
        Node *temp = last;

        cout << "Reverse: ";

        do
        {
            cout << temp->data << " ";
            temp = temp->prev;
        } while (temp != last);

        cout << endl;
    }

    void insertPosition()
    {
        int position, value;

        cout << "Enter position: ";
        cin >> position;

        cout << "Enter value: ";
        cin >> value;

        if (position == 1)
        {
            Node *newNode = new Node;
            newNode->data = value;

            if (head == NULL)
            {
                newNode->next = newNode;
                newNode->prev = newNode;
                head = newNode;
            }
            else
            {
                Node *last = head->prev;

                newNode->next = head;
                newNode->prev = last;

                last->next = newNode;
                head->prev = newNode;

                head = newNode;
            }

            return;
        }

        if (head == NULL)
        {
            cout << "Invalid position." << endl;
            return;
        }

        Node *temp = head;

        for (int i = 1; i < position - 1; i++)
        {
            temp = temp->next;

            if (temp == head)
            {
                cout << "Invalid position." << endl;
                return;
            }
        }

        Node *newNode = new Node;

        newNode->data = value;
        newNode->prev = temp;
        newNode->next = temp->next;

        temp->next->prev = newNode;
        temp->next = newNode;
    }

    void insertBefore()
    {
        int key, value;

        cout << "Enter desired element: ";
        cin >> key;

        cout << "Enter value: ";
        cin >> value;

        if (head == NULL)
            return;

        Node *temp = head;

        do
        {
            if (temp->data == key)
            {
                Node *newNode = new Node;

                newNode->data = value;
                newNode->next = temp;
                newNode->prev = temp->prev;

                temp->prev->next = newNode;
                temp->prev = newNode;

                if (temp == head)
                    head = newNode;

                return;
            }

            temp = temp->next;

        } while (temp != head);

        cout << "Element not found." << endl;
    }

    void insertAfter()
    {
        int key, value;

        cout << "Enter desired element: ";
        cin >> key;

        cout << "Enter value: ";
        cin >> value;

        if (head == NULL)
            return;

        Node *temp = head;

        do
        {
            if (temp->data == key)
            {
                Node *newNode = new Node;

                newNode->data = value;
                newNode->prev = temp;
                newNode->next = temp->next;

                temp->next->prev = newNode;
                temp->next = newNode;

                return;
            }

            temp = temp->next;

        } while (temp != head);

        cout << "Element not found." << endl;
    }

    void deleteFirst()
    {
        if (head == NULL)
            return;

        if (head->next == head)
        {
            delete head;
            head = NULL;
            return;
        }

        Node *last = head->prev;
        Node *del = head;

        head = head->next;

        last->next = head;
        head->prev = last;

        delete del;
    }

    void deleteLast()
    {
        if (head == NULL)
            return;

        if (head->next == head)
        {
            delete head;
            head = NULL;
            return;
        }

        Node *last = head->prev;
        Node *newLast = last->prev;

        newLast->next = head;
        head->prev = newLast;

        delete last;
    }

    void deleteDesired()
    {
        int key;

        cout << "Enter element: ";
        cin >> key;

        if (head == NULL)
            return;

        Node *temp = head;

        do
        {
            if (temp->data == key)
            {
                if (temp == head)
                {
                    deleteFirst();
                    return;
                }

                temp->prev->next = temp->next;
                temp->next->prev = temp->prev;

                delete temp;

                return;
            }

            temp = temp->next;

        } while (temp != head);

        cout << "Element not found." << endl;
    }

    void deleteBefore()
    {
        int key;

        cout << "Enter element: ";
        cin >> key;

        if (head == NULL)
            return;

        Node *temp = head;

        do
        {
            if (temp->data == key)
            {
                Node *del = temp->prev;

                if (del == temp)
                {
                    cout << "Operation not possible." << endl;
                    return;
                }

                if (del == head)
                    head = temp;

                del->prev->next = temp;
                temp->prev = del->prev;

                delete del;

                return;
            }

            temp = temp->next;

        } while (temp != head);

        cout << "Element not found." << endl;
    }

    void deleteAfter()
    {
        int key;

        cout << "Enter element: ";
        cin >> key;

        if (head == NULL)
            return;

        Node *temp = head;

        do
        {
            if (temp->data == key)
            {
                Node *del = temp->next;

                if (del == temp)
                {
                    cout << "Operation not possible." << endl;
                    return;
                }

                temp->next = del->next;
                del->next->prev = temp;

                if (del == head)
                    head = del->next;

                delete del;

                return;
            }

            temp = temp->next;

        } while (temp != head);

        cout << "Element not found." << endl;
    }

    void search()
    {
        int key, position = 1;

        cout << "Enter element: ";
        cin >> key;

        if (head == NULL)
            return;

        Node *temp = head;

        do
        {
            if (temp->data == key)
            {
                cout << "Element found at position "
                     << position << endl;
                return;
            }

            temp = temp->next;
            position++;

        } while (temp != head);

        cout << "Element not found." << endl;
    }

    void sortList()
    {
        if (head == NULL)
            return;

        Node *i = head;

        do
        {
            Node *j = i->next;

            while (j != head)
            {
                if (i->data > j->data)
                    swap(i->data, j->data);

                j = j->next;
            }

            i = i->next;

        } while (i != head);

        cout << "List sorted." << endl;
    }

    void update()
    {
        int position, value;

        cout << "Enter position: ";
        cin >> position;

        cout << "Enter new value: ";
        cin >> value;

        if (head == NULL)
            return;

        Node *temp = head;

        for (int i = 1; i < position; i++)
        {
            temp = temp->next;

            if (temp == head)
            {
                cout << "Invalid position." << endl;
                return;
            }
        }

        temp->data = value;
    }

    void countNodes()
    {
        if (head == NULL)
        {
            cout << "Number of nodes = 0" << endl;
            return;
        }

        int count = 0;
        Node *temp = head;

        do
        {
            count++;
            temp = temp->next;
        } while (temp != head);

        cout << "Number of nodes = "
             << count << endl;
    }

    ~CircularDoublyList()
    {
        if (head == NULL)
            return;

        Node *temp = head->next;

        while (temp != head)
        {
            Node *del = temp;
            temp = temp->next;
            delete del;
        }

        delete head;
    }
};

int main()
{
    CircularDoublyList list;

    int choice;

    do
    {
        cout << "\n===== CIRCULAR DOUBLY LINKED LIST =====" << endl;
        cout << "1. Create" << endl;
        cout << "2. Display" << endl;
        cout << "3. Display Reverse" << endl;
        cout << "4. Insert First" << endl;
        cout << "5. Insert Last" << endl;
        cout << "6. Insert Desired Position" << endl;
        cout << "7. Insert Before Desired" << endl;
        cout << "8. Insert After Desired" << endl;
        cout << "9. Delete First" << endl;
        cout << "10. Delete Last" << endl;
        cout << "11. Delete Desired" << endl;
        cout << "12. Delete Before Desired" << endl;
        cout << "13. Delete After Desired" << endl;
        cout << "14. Search" << endl;
        cout << "15. Sort" << endl;
        cout << "16. Update" << endl;
        cout << "17. Count Nodes" << endl;
        cout << "18. Exit" << endl;

        cout << "Enter choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1: list.create(); break;
        case 2: list.display(); break;
        case 3: list.displayReverse(); break;
        case 4: list.insertFirst(); break;
        case 5: list.insertLast(); break;
        case 6: list.insertPosition(); break;
        case 7: list.insertBefore(); break;
        case 8: list.insertAfter(); break;
        case 9: list.deleteFirst(); break;
        case 10: list.deleteLast(); break;
        case 11: list.deleteDesired(); break;
        case 12: list.deleteBefore(); break;
        case 13: list.deleteAfter(); break;
        case 14: list.search(); break;
        case 15: list.sortList(); break;
        case 16: list.update(); break;
        case 17: list.countNodes(); break;
        case 18: break;
        default: cout << "Invalid choice!" << endl;
        }

    } while (choice != 18);

    return 0;
}
