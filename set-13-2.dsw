// Binary search (with recursion, without recursion)*/

#include <iostream>
using namespace std;

int main()
{
    int n;
    int a[100];
    int key;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements in ascending order:\n";

    for (int i = 0; i < n; i++)
        cin >> a[i];

    cout << "Enter element to search: ";
    cin >> key;

    int low = 0;
    int high = n - 1;
    bool found = false;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        if (a[mid] == key)
        {
            cout << "Element found at position "
                 << mid + 1 << endl;

            found = true;
            break;
        }
        else if (key < a[mid])
        {
            high = mid - 1;
        }
        else
        {
            low = mid + 1;
        }
    }

    if (!found)
        cout << "Element not found." << endl;

    return 0;
}
